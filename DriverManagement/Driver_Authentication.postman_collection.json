{
	"info": {
		"name": "Driver Authentication API",
		"description": "Postman collection for testing Driver sign-up, OTP verification, and sign-in endpoints",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "1. Register Driver (Sign-Up)",
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n  \"firstName\": \"John\",\n  \"lastName\": \"Doe\",\n  \"dateOfBirth\": \"1990-05-15\",\n  \"email\": \"john.driver@example.com\",\n  \"phone1\": \"+94771234567\",\n  \"phone2\": \"+94779876543\",\n  \"addressLine1\": \"123 Main Street\",\n  \"addressLine2\": \"Apt 4B\",\n  \"city\": \"Colombo\",\n  \"stateProvince\": \"Western Province\",\n  \"postalCode\": \"00100\",\n  \"licensePdfUrl\": \"https://example.com/license.pdf\",\n  \"nicNumber\": \"901234567V\",\n  \"password\": \"Driver@123\"\n}",
					"options": {
						"raw": {
							"language": "json"
						}
					}
				},
				"url": {
					"raw": "http://localhost:8092/driveController/api/v1/auth/register",
					"protocol": "http",
					"host": [
						"localhost"
					],
					"port": "8092",
					"path": [
						"driveController",
						"api",
						"v1",
						"auth",
						"register"
					]
				},
				"description": "Registers a new driver. An OTP will be sent to the provided email address for verification."
			},
			"response": []
		},
		{
			"name": "2. Verify OTP",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"if (pm.response.code === 200) {",
							"    var jsonData = pm.response.json();",
							"    if (jsonData.token) {",
							"        pm.environment.set(\"driver_token\", jsonData.token);",
							"        pm.environment.set(\"driver_email\", jsonData.email);",
							"        pm.environment.set(\"driver_id\", jsonData.driverId);",
							"        console.log(\"Token saved:\", jsonData.token);",
							"    }",
							"}"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n  \"email\": \"john.driver@example.com\",\n  \"otp\": \"123456\"\n}",
					"options": {
						"raw": {
							"language": "json"
						}
					}
				},
				"url": {
					"raw": "http://localhost:8092/driveController/api/v1/auth/verify-otp",
					"protocol": "http",
					"host": [
						"localhost"
					],
					"port": "8092",
					"path": [
						"driveController",
						"api",
						"v1",
						"auth",
						"verify-otp"
					]
				},
				"description": "Verifies the OTP code sent to the driver's email. On success, returns a JWT token and marks email as verified. Replace the OTP with the actual code received in email."
			},
			"response": []
		},
		{
			"name": "3. Resend OTP",
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					}
				],
				"url": {
					"raw": "http://localhost:8092/driveController/api/v1/auth/resend-otp?email=john.driver@example.com",
					"protocol": "http",
					"host": [
						"localhost"
					],
					"port": "8092",
					"path": [
						"driveController",
						"api",
						"v1",
						"auth",
						"resend-otp"
					],
					"query": [
						{
							"key": "email",
							"value": "john.driver@example.com",
							"description": "Driver's email address"
						}
					]
				},
				"description": "Resends a new OTP to the driver's email. Use this if you didn't receive the OTP or it expired."
			},
			"response": []
		},
		{
			"name": "4. Login Driver (Sign-In)",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"if (pm.response.code === 200) {",
							"    var jsonData = pm.response.json();",
							"    if (jsonData.token) {",
							"        pm.environment.set(\"driver_token\", jsonData.token);",
							"        pm.environment.set(\"driver_email\", jsonData.email);",
							"        pm.environment.set(\"driver_id\", jsonData.driverId);",
							"        console.log(\"Token saved:\", jsonData.token);",
							"    }",
							"}"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n  \"email\": \"john.driver@example.com\",\n  \"password\": \"Driver@123\"\n}",
					"options": {
						"raw": {
							"language": "json"
						}
					}
				},
				"url": {
					"raw": "http://localhost:8092/driveController/api/v1/auth/login",
					"protocol": "http",
					"host": [
						"localhost"
					],
					"port": "8092",
					"path": [
						"driveController",
						"api",
						"v1",
						"auth",
						"login"
					]
				},
				"description": "Logs in a driver with email and password. Email must be verified first. Returns JWT token for authenticated requests."
			},
			"response": []
		},
		{
			"name": "5. Get Driver by ID (Authenticated)",
			"request": {
				"method": "GET",
				"header": [
					{
						"key": "Authorization",
						"value": "Bearer {{driver_token}}",
						"description": "JWT token from login/verify-otp"
					}
				],
				"url": {
					"raw": "http://localhost:8092/driveController/api/v1/1",
					"protocol": "http",
					"host": [
						"localhost"
					],
					"port": "8092",
					"path": [
						"driveController",
						"api",
						"v1",
						"1"
					]
				},
				"description": "Example of using the JWT token for authenticated requests. Replace '1' with actual driver ID."
			},
			"response": []
		}
	],
	"variable": [
		{
			"key": "base_url",
			"value": "http://localhost:8092",
			"type": "string"
		},
		{
			"key": "driver_token",
			"value": "",
			"type": "string"
		},
		{
			"key": "driver_email",
			"value": "",
			"type": "string"
		},
		{
			"key": "driver_id",
			"value": "",
			"type": "string"
		}
	]
}

